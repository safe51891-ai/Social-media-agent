# Copy to .env and fill in. Empty values are fine: a platform with no credentials is skipped.

# --- OpenAI (required) ---
OPENAI_API_KEY=sk-...
TEXT_MODEL=gpt-4.1          # use any text model your account has access to
IMAGE_MODEL=gpt-image-1
MAKE_IMAGES=true
LLM_TIMEOUT=90

# --- Storage (relative paths are resolved from the project folder) ---
DATA_DIR=data               # database, checkpoints, uploaded videos
OUTPUT_DIR=output           # one folder per run: blog, script, image, posts

# --- Access control. Set this before exposing the app on the internet. ---
APP_PASSWORD=               # when set, the UI and API ask for a password (any username)

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- X (developer app with user OAuth 1.0a keys) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- Facebook Page ---
FB_PAGE_ID=
FB_PAGE_TOKEN=
GRAPH_VERSION=v21.0         # check Meta's current version

# --- Instagram (business account linked to the Page) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
PUBLIC_MEDIA_BASE_URL=      # public URL that serves OUTPUT_DIR, e.g. https://example.com/output

# --- LinkedIn ---
LINKEDIN_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:xxxx
LINKEDIN_API_VERSION=202506
